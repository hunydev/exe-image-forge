[Unit]
Description=Refresh exe-image-forge images with the latest AI CLI releases
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=exedev
SupplementaryGroups=docker
ExecStart=/usr/local/bin/exe-image-forge refresh
TimeoutStartSec=60min
Nice=10
IOSchedulingClass=idle
