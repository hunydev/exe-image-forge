#!/usr/bin/env bash
# exe-image-forge - build & vend custom exe.dev-compatible images with pre-authenticated AI CLIs.
set -euo pipefail

# Host-specific values live outside the repository. The systemd units load the
# same file, and FORGE_ENV_FILE makes isolated/test installations possible.
ENV_FILE="${FORGE_ENV_FILE:-/etc/exe-image-forge/forge.env}"
if [ -r "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT="${FORGE_ROOT:-$SCRIPT_DIR}"
AUTHHOME="${FORGE_AUTH_HOME:-/var/lib/exe-image-forge/authhome}"
IMAGE_PREFIX="${FORGE_IMAGE_PREFIX:-exe-image-forge}"
BASE_REPO="${IMAGE_PREFIX}/base"
DEV_REPO="${IMAGE_PREFIX}/dev"
BASE="${BASE_REPO}:latest"
# The variant containing every CLI: used for logins and for credential
# conversion, since lean variants may omit any optional tool.
BASE_FULL="${BASE_REPO}:go-gemini"

# Layer compression. zstd decompresses far faster than gzip and produces
# smaller blobs; the registry, docker and containerd all understand it. Set
# COMPRESSION=gzip if you ever need to serve a client that does not.
COMPRESSION=${COMPRESSION:-zstd}
COMPRESSION_LEVEL=${COMPRESSION_LEVEL:-9}
DEV="${DEV_REPO}:latest"
CFG="${FORGE_CONFIG:-/etc/exe-image-forge/config.json}"
STATE="${FORGE_STATE:-/var/lib/exe-image-forge/grants.json}"
INSTALL_DIR="${FORGE_INSTALL_DIR:-/opt/exe-image-forge}"
SERVICE_NAME="${FORGE_SERVICE_NAME:-exe-image-forge-vend.service}"
REGISTRY_NAME="${FORGE_REGISTRY_NAME:-exe-image-forge-registry}"
REGISTRY_DATA="${FORGE_REGISTRY_DATA:-/var/lib/exe-image-forge/registry}"
REGISTRY_LOCK="${FORGE_REGISTRY_LOCK:-$(dirname "$STATE")/registry.lock}"
INITIAL_PASSWORD_FILE="${FORGE_INITIAL_PASSWORD_FILE:-/var/lib/exe-image-forge/initial-password}"
VM_NAME="${FORGE_VM_NAME:-$(hostname)}"
VEND_ADDR="${FORGE_ADDR:-127.0.0.1:8000}"
MIN_FREE_BYTES="${FORGE_MIN_FREE_BYTES:-2147483648}"
MAX_DISK_PERCENT="${FORGE_MAX_DISK_PERCENT:-90}"
BUILD_CACHE_MIN_FREE="${FORGE_BUILD_CACHE_MIN_FREE:-5gb}"
BUILD_CACHE_RESERVED="${FORGE_BUILD_CACHE_RESERVED:-2gb}"

# The Go service uses this when it needs a full CLI image for the web terminal
# and credential inspection. Exporting it keeps shell and service behavior in
# sync even when an installation uses a custom image prefix.
export FORGE_BASE_IMAGE="$BASE"
export FORGE_COMMAND_PATH="${FORGE_COMMAND_PATH:-/usr/local/bin/exe-image-forge}"

# The historical min/gemini/go/go-gemini tags retain Codex + Claude. Prefixes
# describe variants with only one or neither agent, keeping old deployments and
# cached clients compatible while allowing every large component to be omitted.
VARIANTS=(
  core core-gemini core-go core-go-gemini
  codex codex-gemini codex-go codex-go-gemini
  claude claude-gemini claude-go claude-go-gemini
  min gemini go go-gemini
)

# Exactly what gets baked into the shipped image. Credentials and settings
# only -- never history, sessions, logs or caches. Adding an entry here means
# it goes out to everyone who pulls an image, so keep it to auth material.
CRED_FILES=(
  .config/gh/hosts.yml
  .config/gh/config.yml
  .config/.wrangler/config/default.toml
  .codex/auth.json
  .codex/config.toml
  .claude/.credentials.json
  .claude/settings.json
  .gemini/gemini-credentials.json
  .gemini/oauth_creds.json
  .gemini/google_accounts.json
  .gemini/settings.json
  .gitconfig
)

# variant_args prints the docker --build-arg flags for a variant tag.
variant_args(){
  local v="$1" codex=0 claude=0 go=0 gemini=0
  case "$v" in
    min|gemini|go|go-gemini) codex=1; claude=1 ;;
    codex|codex-*) codex=1 ;;
    claude|claude-*) claude=1 ;;
    core|core-*) ;;
    *) die "unknown variant: $v" ;;
  esac
  case "$v" in
    go|go-gemini|*-go|*-go-gemini) go=1 ;;
  esac
  case "$v" in
    gemini|go-gemini|*-gemini) gemini=1 ;;
  esac
  echo "--build-arg WITH_CODEX=$codex --build-arg WITH_CLAUDE=$claude --build-arg WITH_GO=$go --build-arg WITH_GEMINI=$gemini"
}

log(){ printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die(){ printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
warn(){ printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }

require_disk_headroom(){
  local purpose="${1:-operation}" available percent available_bytes
  read -r available percent < <(
    df -Pk "$REGISTRY_DATA" | awk 'NR==2 {gsub(/%/,"",$5); print $4, $5}'
  )
  available_bytes=$((available * 1024))
  if [ "$available_bytes" -lt "$MIN_FREE_BYTES" ] || [ "$percent" -ge "$MAX_DISK_PERCENT" ]; then
    die "$purpose blocked: disk is ${percent}% used with $(numfmt --to=iec "$available_bytes") free; run 'exe-image-forge gc'"
  fi
}

ensure_authhome(){
  if [ ! -d "$AUTHHOME" ]; then
    log "creating auth home $AUTHHOME"
    sudo mkdir -p "$AUTHHOME"
    sudo chown 1000:1000 "$AUTHHOME"
    docker run --rm -v "$AUTHHOME":/mnt "$BASE" \
      bash -c 'cp -a /home/exedev/. /mnt/ 2>/dev/null || true; chown -R 1000:1000 /mnt'
  fi
}

cmd_build(){
  local args=(--pull) only=""
  require_disk_headroom "build"
  if [ "${1:-}" = "--fresh" ]; then
    args+=(--build-arg "CLI_REFRESH=$(date +%s)")
    log "forcing fresh AI CLI versions"
    shift
  fi
  # `exe-image-forge build <variant>` rebuilds just one, which is much faster when
  # iterating on the Dockerfile.
  [ -n "${1:-}" ] && only="$1"

  for v in "${VARIANTS[@]}"; do
    [ -n "$only" ] && [ "$only" != "$v" ] && continue
    log "building $BASE_REPO:$v"
    # zstd instead of gzip: ~20% smaller on the wire (497MB -> 399MB for min)
    # and roughly 5x faster to decompress, which is most of the wait after the
    # bytes arrive. force-compression is required, or buildx passes through the
    # gzip layers it already has.
    # shellcheck disable=SC2046
    docker buildx build "${args[@]}" $(variant_args "$v") --build-arg "VARIANT=$v" \
      --output "type=image,name=$BASE_REPO:$v,compression=$COMPRESSION,compression-level=$COMPRESSION_LEVEL,force-compression=true" \
      -f "$ROOT/image/Dockerfile" "$ROOT/image"
  done

  # :latest is the default variant, so existing refs and `docker pull` without
  # a tag keep working.
  docker tag "$BASE_REPO:min" "$BASE"

  log "verifying $BASE_REPO:min"
  docker run --rm "$BASE_REPO:min" bash -lc \
    'node -v; npm -v; python3 -V; uv --version; gh --version|head -1; codex --version; claude --version'
  cmd_sizes
  log "done. next: exe-image-forge auth <tool>, then exe-image-forge bake"
}

cmd_sizes(){
  log "variant sizes (layers are shared; total disk is far less than the sum)"
  for v in "${VARIANTS[@]}" ; do
    local id sz
    id=$(docker image inspect "$BASE_REPO:$v" --format '{{.Size}}' 2>/dev/null) || continue
    sz=$(numfmt --to=iec <<<"$id")
    printf '   %-20s %s\n' "$v" "$sz"
  done
}

cmd_shell(){
  ensure_authhome
  log "interactive shell in $BASE with persistent HOME ($AUTHHOME)"
  log "host network is shared; tunnel a callback with 'ssh -L <port>:localhost:<port> ${VM_NAME}.exe.xyz'"
  docker run --rm -it --network host -e HOME=/home/exedev -u 1000:1000 \
    -v "$AUTHHOME":/home/exedev -w /home/exedev "$BASE" bash -l
}

cmd_auth(){
  ensure_authhome
  local tool=${1:-}; shift || true
  # Log in against the fullest variant: lean variants may omit an AI CLI, and
  # the credentials land in $AUTHHOME which every variant shares.
  local img="$BASE_FULL"
  docker image inspect "$img" >/dev/null 2>&1 || img="$BASE"
  local run=(docker run --rm -it --network host -e HOME=/home/exedev -u 1000:1000
             -v "$AUTHHOME":/home/exedev -w /home/exedev "$img")
  # gh and codex use device codes; Claude and headless Gemini accept a pasted
  # code. Wrangler always returns to localhost:8976, so the web/CLI relay must
  # replay the browser's final callback while the command is still waiting.
  case "$tool" in
    gh)     "${run[@]}" gh auth login --git-protocol https "$@" ;;
    codex)  "${run[@]}" codex login --device-auth "$@" ;;
    # NOT `claude setup-token`: that only prints a token to export and writes
    # nothing to disk, so the bake would pick up no credentials at all.
    claude) "${run[@]}" claude auth login "$@" ;;
    claude-token) "${run[@]}" claude setup-token ;;
    gemini)
      cat <<'EOF'
NO_BROWSER=true makes Gemini redirect to https://codeassist.google.com/authcode
and ask you to paste the code back, so no localhost callback is involved.

If it somehow still sends you to http://localhost:<port>/oauth2callback?... then
that port is here on the VM, not on your laptop. Copy that dead URL and run:

  exe-image-forge relay '<paste the whole localhost URL>'
EOF
      "${run[@]}" env NO_BROWSER=true gemini "$@" ;;
    wrangler)
      cat <<'EOF'
Wrangler redirects to http://localhost:8976 after browser authorization.
That URL is on the VM, not your laptop. Leave this command waiting, copy the
complete failed localhost URL from the browser, and relay it from another
terminal or from Admin > Logins:

  exe-image-forge relay '<paste the whole localhost URL>'

--no-use-keyring keeps the OAuth refresh token portable for credential baking.
EOF
      "${run[@]}" wrangler login --no-use-keyring "$@" ;;
    all)    for t in gh codex claude gemini wrangler; do cmd_auth "$t"; done ;;
    *) die "usage: exe-image-forge auth {gh|codex|claude|gemini|wrangler|all}" ;;
  esac
}

cmd_status(){
  ensure_authhome
  echo "auth home: $AUTHHOME"
  for f in .config/gh/hosts.yml .codex/auth.json .claude/.credentials.json .claude.json \
           .gemini/gemini-credentials.json .gemini/google_accounts.json \
           .config/.wrangler/config/default.toml; do
    if sudo test -s "$AUTHHOME/$f"; then printf '  \033[32m✓\033[0m %s\n' "$f"; else printf '  \033[31m✗\033[0m %s\n' "$f"; fi
  done
  echo
  local img="$BASE_FULL"
  docker image inspect "$img" >/dev/null 2>&1 || img="$BASE"
  docker run --rm --network host -e HOME=/home/exedev -u 1000:1000 -v "$AUTHHOME":/home/exedev "$img" \
    bash -lc '
      echo "-- gh:";     gh auth status 2>&1|sed "s/^/   /"
      echo "-- codex:";  codex login status 2>&1|sed "s/^/   /"
      echo "-- claude:"; claude auth status --text 2>&1|sed "s/^/   /"
      echo "-- gemini:"; if [ -s ~/.gemini/gemini-credentials.json ] || [ -s ~/.gemini/oauth_creds.json ]; then
        # "active" is null right after login; the address is under "old".
        acct=$(grep -oE "[A-Za-z0-9._%%+-]+@[A-Za-z0-9.-]+" ~/.gemini/google_accounts.json 2>/dev/null | head -1)
        echo "   logged in${acct:+ ($acct)}"
      else echo "   not logged in"; fi
      echo "-- wrangler:"; wrangler whoami 2>&1|sed "s/^/   /"
    ' || true
}

cmd_bake(){
  require_disk_headroom "bake"
  ensure_authhome
  local only="${1:-}"
  CTX=$(mktemp -d)
  trap 'sudo rm -rf "${CTX:-/nonexistent}"' EXIT
  # Copy ONLY credential files into the image. This used to be a denylist over
  # the whole auth home, which shipped whatever else the admin terminal left
  # behind: gemini writes every prompt to .gemini/tmp/*/logs.json and
  # chats/*.jsonl, codex keeps threads in state_*.sqlite, and .bash_history
  # records the session. Those would have been baked into an image handed to
  # other people. An allowlist cannot leak something we forgot to think of.
  # Gemini encrypts its credentials with a key derived from the hostname, so
  # the encrypted file is useless in an image that boots elsewhere. Convert it
  # to a portable form first, on this host, where it can still be decrypted.
  GEMINI_API_KEY_BAKE=""
  if sudo test -s "$AUTHHOME/.gemini/gemini-credentials.json"; then
    local conv
    conv=$(docker run --rm --entrypoint node -u 1000:1000 --hostname "$(hostname)" \
      -v "$AUTHHOME/.gemini":/g -v "$ROOT/image/files/gemini-export-creds.js":/c.js \
      "$BASE_FULL" /c.js /g 2>/dev/null) || true
    case "$conv" in
      apikey\ *) GEMINI_API_KEY_BAKE="${conv#apikey }"
                 log "gemini: API key credential; baking GEMINI_API_KEY" ;;
      oauth*)    log "gemini: converted OAuth token to portable oauth_creds.json" ;;
      *)         warn "gemini: could not convert credentials; the image may not be logged in" ;;
    esac
  fi

  local staged; staged=$(mktemp -d); chmod 755 "$staged"
  local f
  for f in "${CRED_FILES[@]}"; do
    sudo test -e "$AUTHHOME/$f" || continue
    sudo mkdir -p "$staged/$(dirname "$f")"
    sudo cp -a "$AUTHHOME/$f" "$staged/$f"
  done
  sudo chown -R 1000:1000 "$staged"
  sudo tar -C "$staged" -cf "$CTX/home.tar" . 2>/dev/null || true
  sudo chown "$(id -u):$(id -g)" "$CTX/home.tar"
  log "baking $(sudo tar -tf "$CTX/home.tar" | grep -vc '/$') credential file(s):"
  sudo tar -tf "$CTX/home.tar" | grep -v '/$' | sed 's/^\./  /'
  sudo rm -rf "$staged"
  local stamp; stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  for v in "${VARIANTS[@]}"; do
    [ -n "$only" ] && [ "$only" != "$v" ] && continue
    docker image inspect "$BASE_REPO:$v" >/dev/null 2>&1 || {
      log "$BASE_REPO:$v not built yet; skipping"; continue; }
    log "baking $DEV_REPO:$v"
    cat > "$CTX/Dockerfile" <<EOF
FROM $BASE_REPO:$v
ADD --chown=1000:1000 home.tar /home/exedev/
RUN touch /etc/exe-image-forge-credentialed
LABEL "dev.exe.image-forge.image"="dev"
LABEL "dev.exe.image-forge.variant"="$v"
LABEL "dev.exe.image-forge.baked"="$stamp"
EOF
    # An API-key login has nothing on disk for the CLI to find; it reads the
    # environment instead.
    [ -n "$GEMINI_API_KEY_BAKE" ] && \
      echo "ENV GEMINI_API_KEY=$GEMINI_API_KEY_BAKE" >> "$CTX/Dockerfile"
    docker buildx build --provenance=false --sbom=false \
      --output "type=image,name=$DEV_REPO:$v,compression=$COMPRESSION,compression-level=$COMPRESSION_LEVEL,force-compression=true" \
      "$CTX"
  done
  docker tag "$DEV_REPO:min" "$DEV" 2>/dev/null || true

  # A dev image whose whole purpose is carrying logins, that ships logged out,
  # is worse than no image: it looks fine until someone tries to use it.
  local checked="${only:-min}"
  if docker image inspect "$DEV_REPO:$checked" >/dev/null 2>&1; then
    local bad=0 out
    out=$(docker run --rm -u 1000:1000 -e HOME=/home/exedev --entrypoint bash \
      "$DEV_REPO:$checked" -c '
        echo present:gh
        gh auth status >/dev/null 2>&1 && echo auth:gh
        if command -v codex >/dev/null; then
          echo present:codex
          codex login status >/dev/null 2>&1 && echo auth:codex
        fi
        if command -v claude >/dev/null; then
          echo present:claude
          claude auth status --json 2>/dev/null | tr -d " " | grep -q "loggedIn\":true" && echo auth:claude
        fi
        if command -v gemini >/dev/null; then
          echo present:gemini
          { [ -s ~/.gemini/gemini-credentials.json ] || [ -s ~/.gemini/oauth_creds.json ] \
            || [ -n "${GEMINI_API_KEY:-}" ]; } && echo auth:gemini
        fi
        if command -v wrangler >/dev/null; then
          echo present:wrangler
          wrangler whoami >/dev/null 2>&1 && echo auth:wrangler
        fi
      ' 2>/dev/null) || true
    for t in gh codex claude gemini wrangler; do
      if grep -qx "present:$t" <<<"$out"; then
        grep -qx "auth:$t" <<<"$out" || { warn "baked image: $t is NOT logged in"; bad=1; }
      else
        log "baked image: $t not included in variant $checked; auth check skipped"
      fi
    done
    [ "$bad" = 0 ] && log "verified: every included CLI is authenticated in $DEV_REPO:$checked"
  fi
  log "baked. vend $DEV_REPO (not $BASE_REPO) to include credentials"
}

cmd_verify(){
  local img=${1:-$DEV}
  log "verifying $img"
  # Optional components are absent from the lean variants by design, so report
  # them rather than emitting a command-not-found that looks like a failure.
  docker run --rm -u 1000:1000 -e HOME=/home/exedev --entrypoint bash "$img" -lc '
    set +e
    echo "-- versions"
    node -v; python3 -V; uv --version; gh --version|head -1
    if command -v codex >/dev/null; then codex --version; else echo "codex: not in this variant"; fi
    if command -v claude >/dev/null; then claude --version; else echo "claude: not in this variant"; fi
    if command -v go     >/dev/null; then go version|cut -d" " -f3; else echo "go: not in this variant"; fi
    if command -v gemini >/dev/null; then gemini --version;         else echo "gemini: not in this variant"; fi
    wrangler --version
    echo "-- auth"
    gh auth status 2>&1|sed -n 2,3p
    if command -v codex >/dev/null; then codex login status 2>&1|head -1; fi
    if command -v claude >/dev/null; then claude auth status --text 2>&1|head -1; fi
    if command -v gemini >/dev/null; then
      if [ -s ~/.gemini/gemini-credentials.json ] || [ -s ~/.gemini/oauth_creds.json ] \
         || [ -n "${GEMINI_API_KEY:-}" ]; then echo "gemini: logged in"; else echo "gemini: NOT logged in"; fi
    fi
    wrangler whoami 2>&1|sed -n "1,4p"'
}

cmd_import(){
  ensure_authhome
  # Import credentials produced on another machine (your laptop, where the
  # OAuth browser flow is easy). Accepts a tar stream on stdin or file paths.
  local src=${1:--}
  if [ "$src" = "-" ]; then
    log "reading credential tar from stdin into $AUTHHOME"
    sudo tar -C "$AUTHHOME" -xf - "$@" 2>/dev/null || sudo tar -C "$AUTHHOME" -xf -
  else
    log "extracting $src into $AUTHHOME"
    sudo tar -C "$AUTHHOME" -xf "$src"
  fi
  sudo chown -R 1000:1000 "$AUTHHOME"
  cmd_status
}

cmd_export_hint(){
  cat <<EOF
Run this on the machine where you are already logged in, then pipe it here:

  tar -C "\$HOME" -cf - \
      .config/gh/hosts.yml \
      .codex/auth.json \
      .claude/.credentials.json .claude.json \
      .gemini/oauth_creds.json .gemini/google_accounts.json \
      .config/.wrangler/config/default.toml 2>/dev/null \
    | ssh ${VM_NAME}.exe.xyz exe-image-forge import -

Omit any file you do not have. Then: exe-image-forge bake
EOF
}

cmd_token(){
  # exe.dev's HTTPS proxy is auth-gated, so a laptop 'docker pull' needs a VM
  # bearer token (used as the basic-auth password). Store it so the web UI can
  # print a ready-to-paste docker login line.
  local t=${1:-}
  if [ -z "$t" ]; then
  cat <<EOF
Create a VM token on your laptop:

  ssh exe.dev ssh-key generate-api-key --vm=${VM_NAME} --label=registry

Then store it here:

  exe-image-forge token <TOKEN>       # or: exe-image-forge token clear
EOF
    return
  fi
  [ "$t" = clear ] && t=""
  sudo python3 - "$CFG" "$t" <<'PY'
import json, sys
p=sys.argv[1]
c=json.load(open(p)); c['vm_token']=sys.argv[2]
with open(p, 'w') as f:
    json.dump(c, f, indent=2)
PY
  sudo chmod 600 "$CFG"
  sudo systemctl restart "$SERVICE_NAME"
  log "vm token ${t:+stored}${t:-cleared}"
}

cmd_relay(){
  # Replay a localhost OAuth callback from inside the VM, where the CLI's
  # throwaway listener actually is.
  local u=${1:-}
  [ -n "$u" ] || die "usage: exe-image-forge relay '<http://localhost:PORT/oauth2callback?...>'"
  case "$u" in
    http://localhost:*|http://127.0.0.1:*|https://localhost:*|https://127.0.0.1:*) ;;
    *) die "only localhost / 127.0.0.1 callback URLs are allowed" ;;
  esac
  log "relaying to ${u%%\?*}"
  curl -sS --max-time 20 "$u" && echo
  log "check the terminal running the OAuth login for the result"
}

cmd_password(){
  read -rsp "new password: " p1; echo
  read -rsp "again: " p2; echo
  [ "$p1" = "$p2" ] || die "mismatch"
  echo "$p1" | sudo "$INSTALL_DIR/vend" -set-password -config "$CFG"
  sudo chown exedev:exedev "$CFG"
  sudo rm -f -- "$INITIAL_PASSWORD_FILE"
  sudo systemctl restart "$SERVICE_NAME"
  log "password updated, service restarted"
}

cmd_vend_build(){
  log "rebuilding vend service"
  if command -v go >/dev/null 2>&1; then
    (cd "$ROOT/vend" && go build -o /tmp/vend .)
  else
    log "Go is not installed on this slim appliance; using the pinned builder image"
    docker run --rm -v "$ROOT/vend:/src:ro" -v /tmp:/out -w /src \
      docker.io/library/golang:1.26.5-bookworm go build -o /out/vend .
  fi
  sudo install -d -m0755 "$INSTALL_DIR"
  sudo install -m0755 /tmp/vend "$INSTALL_DIR/vend"
  sudo cp "$ROOT/deploy/exe-image-forge-vend.service" /etc/systemd/system/
  sudo systemctl daemon-reload && sudo systemctl restart "$SERVICE_NAME"
  sleep 1; systemctl is-active "$SERVICE_NAME"
}

cmd_grants(){ curl -s "http://$VEND_ADDR/api/info" | jq .; }

# cmd_refresh rebuilds the base image with current AI CLI releases and re-bakes
# the credentialed image on top, so freshly vended images are never stale.
# Credentials live outside the image (in $AUTHHOME) which is what makes this
# safe to run unattended.
cmd_refresh(){
  local before after
  before=$(docker run --rm --entrypoint cat "$BASE_FULL" /etc/ai-cli-versions.json 2>/dev/null || echo '{}')
  cmd_build --fresh
  after=$(docker run --rm --entrypoint cat "$BASE_FULL" /etc/ai-cli-versions.json 2>/dev/null || echo '{}')
  if [ "$before" = "$after" ]; then
    log "no CLI version changes"
  else
    log "versions changed:"
    diff <(echo "$before") <(echo "$after") | grep -E '^[<>]' || true
  fi
  # Only re-bake if credentials exist; otherwise we would publish an image
  # that silently lost its logins.
  if [ -f "$AUTHHOME/.codex/auth.json" ] || [ -f "$AUTHHOME/.claude/.credentials.json" ] \
     || [ -f "$AUTHHOME/.gemini/oauth_creds.json" ] || [ -f "$AUTHHOME/.config/gh/hosts.yml" ] \
     || [ -f "$AUTHHOME/.config/.wrangler/config/default.toml" ]; then
    cmd_bake
  else
    log "no credentials in $AUTHHOME; skipping bake"
  fi
  docker image prune -f >/dev/null 2>&1 || true
}

cmd_versions(){
  local img="${1:-}"
  if [ -n "$img" ]; then
    log "tool versions in $img"
    docker run --rm --entrypoint cat "$img" /etc/ai-cli-versions.json 2>/dev/null | jq .
    return
  fi
  for v in "${VARIANTS[@]}"; do
    docker image inspect "$BASE_REPO:$v" >/dev/null 2>&1 || continue
    log "$BASE_REPO:$v"
    docker run --rm --entrypoint cat "$BASE_REPO:$v" /etc/ai-cli-versions.json 2>/dev/null \
      | jq -r 'to_entries[]|"   \(.key): \(.value)"'
  done
}

# cmd_context shows the machine-context block the AI CLIs will read.
cmd_context(){
  local v="${1:-min}"
  docker image inspect "$BASE_REPO:$v" >/dev/null 2>&1 || die "variant '$v' not built"
  log "AI agent context in $BASE_REPO:$v (~/.codex/AGENTS.md, .claude/CLAUDE.md, .gemini/GEMINI.md)"
  docker run --rm --entrypoint cat "$BASE_REPO:$v" /home/exedev/.codex/AGENTS.md
}

cmd_gc(){
  local dry_run=0
  case "${1:-}" in
    "") ;;
    --dry-run) dry_run=1 ;;
    *) die "usage: exe-image-forge gc [--dry-run]" ;;
  esac

  sudo install -d -o exedev -g exedev -m0700 "$(dirname "$REGISTRY_LOCK")"
  exec 9>"$REGISTRY_LOCK"
  flock -w 300 9 || die "timed out waiting for registry operations to finish"

  if [ "$dry_run" = 0 ]; then
    log "pruning dangling images and bounded build cache"
    docker image prune -f

    # A grant pulled back through the public proxy creates a tagged local copy.
    # It is never a build source, so remove these labeled copies even though
    # ordinary dangling-image pruning cannot see them.
    while read -r image_id; do
      [ -n "$image_id" ] || continue
      docker image rm -f "$image_id" >/dev/null 2>&1 || true
    done < <(
      {
        docker image ls -q --filter label=dev.exe.image-forge.grant
        docker image ls -q --filter label=dev.huny.grant
      } | sort -u
    )

    docker buildx prune -f \
      --min-free-space "$BUILD_CACHE_MIN_FREE" \
      --reserved-space "$BUILD_CACHE_RESERVED"
  else
    log "dry-run: skipping local image and build-cache pruning"
  fi

  if ! docker inspect "$REGISTRY_NAME" >/dev/null 2>&1; then
    warn "registry container '$REGISTRY_NAME' does not exist; skipping registry GC"
  else
    local registry_image was_running=0 registry_needs_restart=0 gc_rc=0
    restore_registry(){
      if [ "$registry_needs_restart" = 1 ]; then
        docker start "$REGISTRY_NAME" >/dev/null || true
        registry_needs_restart=0
      fi
    }
    trap restore_registry EXIT INT TERM
    registry_image=$(docker inspect -f '{{.Config.Image}}' "$REGISTRY_NAME")
    [ "$(docker inspect -f '{{.State.Running}}' "$REGISTRY_NAME")" = true ] && was_running=1

    if [ "$dry_run" = 1 ]; then
      log "registry GC dry-run (no data will be deleted)"
    else
      log "stopping registry for stop-the-world garbage collection"
      [ "$was_running" = 0 ] || registry_needs_restart=1
      [ "$was_running" = 0 ] || docker stop "$REGISTRY_NAME" >/dev/null
    fi

    local gc_args=(garbage-collect --delete-untagged)
    [ "$dry_run" = 0 ] || gc_args+=(--dry-run)
    gc_args+=(/etc/docker/registry/config.yml)
    if ! docker run --rm --network none --volumes-from "$REGISTRY_NAME" \
      --entrypoint registry "$registry_image" "${gc_args[@]}"; then
      gc_rc=1
      warn "registry garbage collection failed"
    fi

    if [ "$dry_run" = 0 ] && [ "$was_running" = 1 ]; then
      log "restarting registry"
      restore_registry
    fi
    trap - EXIT INT TERM
    [ "$gc_rc" = 0 ] || return "$gc_rc"
  fi
  sudo du -sh "$REGISTRY_DATA"
  df -h / | tail -1
}

case "${1:-help}" in
  build) shift; cmd_build "$@" ;;
  sizes) shift; cmd_sizes "$@" ;;
  context) shift; cmd_context "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  versions) shift; cmd_versions "$@" ;;
  shell) shift; cmd_shell "$@" ;;
  auth) shift; cmd_auth "$@" ;;
  status) shift; cmd_status "$@" ;;
  bake) shift; cmd_bake "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  password) shift; cmd_password "$@" ;;
  token) shift; cmd_token "$@" ;;
  relay) shift; cmd_relay "$@" ;;
  import) shift; cmd_import "$@" ;;
  export-hint) shift; cmd_export_hint "$@" ;;
  vend-build) shift; cmd_vend_build "$@" ;;
  grants) shift; cmd_grants "$@" ;;
  gc) shift; cmd_gc "$@" ;;
  *) cat <<'EOF'
exe-image-forge - custom exe.dev image builder + time-limited image vending

  exe-image-forge build [--fresh] [variant]  rebuild base images (all 16 variants)
  exe-image-forge sizes          show the size of each variant
  exe-image-forge refresh        update AI CLIs, rebuild base, re-bake dev (run by timer)
  exe-image-forge versions [img] show the tool versions baked into an image
  exe-image-forge context [var]  show the machine context the AI CLIs will read
  exe-image-forge auth <tool>    log in: gh | codex | claude | gemini | wrangler | all
  exe-image-forge relay <url>    replay a localhost OAuth callback from the VM
  exe-image-forge import [file]  import credentials from a tar (stdin by default)
  exe-image-forge export-hint    print the command to run on your logged-in machine
  exe-image-forge shell          interactive shell in the image with the persistent auth HOME
  exe-image-forge status         show which credentials are present
  exe-image-forge bake [variant] build <image-prefix>/dev:<variant> with credentials
  exe-image-forge verify [img]   sanity-check an image (tools + auth)
  exe-image-forge password       change the web password
  exe-image-forge token [tok]    store an exe.dev VM token for laptop 'docker pull'
  exe-image-forge vend-build     rebuild/restart the vending service
  exe-image-forge grants         list active grants
  exe-image-forge gc [--dry-run] safely prune Docker, build, and registry garbage
EOF
  ;;
esac
