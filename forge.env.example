# Copy to /etc/exe-image-forge/forge.env. Do not commit your live file.
#
# This file contains host-specific configuration, but never put login tokens or
# the web password here. The web password is hashed in config.json.

FORGE_ROOT="/home/exedev/exe-image-forge"
FORGE_IMAGE_PREFIX="exe-image-forge"
FORGE_VM_NAME="my-forge-vm"

FORGE_CONFIG="/etc/exe-image-forge/config.json"
FORGE_STATE="/var/lib/exe-image-forge/grants.json"
FORGE_AUTH_HOME="/var/lib/exe-image-forge/authhome"
FORGE_INSTALL_DIR="/opt/exe-image-forge"
FORGE_REGISTRY_DATA="/var/lib/exe-image-forge/registry"

FORGE_ADDR="127.0.0.1:8000"
FORGE_BASE_IMAGE="exe-image-forge/base:latest"
FORGE_COMMAND_PATH="/usr/local/bin/exe-image-forge"
FORGE_SERVICE_NAME="exe-image-forge-vend.service"
FORGE_REGISTRY_NAME="exe-image-forge-registry"

# zstd gives smaller layers and faster decompression. gzip is available for
# compatibility with old registry clients.
COMPRESSION="zstd"
COMPRESSION_LEVEL="9"
